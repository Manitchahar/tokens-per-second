---
import { url, SITE } from '../../site';
---
<footer class="site-foot">
  <div class="inner">
    <p class="name">{SITE.name}</p>
    <p class="line">A free course in inference engineering, taught from first principles. Your progress and notes stay in this browser.</p>
    <nav aria-label="Footer">
      <a href={url('learn/')}>Course map</a>
      <a href={url('labs/')}>Labs</a>
      <a href={url('cheatsheets/')}>Cheat sheets</a>
      <a href={url('tools/')}>Tools</a>
      <a href={url('glossary/')}>Glossary</a>
      <a href={url('notes/')}>My notes</a>
    </nav>
  </div>
</footer>

<style>
  .site-foot { border-top: 1px solid var(--rule); margin-top: 6rem; }
  .inner { max-width: 1320px; margin: 0 auto; padding: 2.5rem 24px 3rem; display: grid; grid-template-columns: auto 1fr auto; gap: 1rem 2.5rem; align-items: baseline; }
  .name { font-family: var(--font-display); font-size: 1.1rem; margin: 0; }
  .line { color: var(--text-2); font-size: 0.85rem; margin: 0; max-width: 60ch; }
  nav { display: flex; gap: 1.1rem; font-size: 0.85rem; flex-wrap: wrap; }
  nav a { color: var(--text-2); text-decoration: none; }
  nav a:hover { color: var(--text); }
  @media (max-width: 900px) { .inner { grid-template-columns: 1fr; padding: 2rem 16px; } }
</style>
