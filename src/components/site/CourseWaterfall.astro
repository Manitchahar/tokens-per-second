---
// The course as a branching map: Part 1 is the trunk everyone takes, then the course forks into
// "Build with it" and "Make it fast". Every block shares one grid (label, lesson cells, hours) so
// the columns line up. Cells fill in as the learner finishes lessons (progress.ts paints anything
// carrying data-lesson-key).
import { modules, flatLessons, parts, totalMinutes } from '../../data/course';
import { url } from '../../site';

const W = 1000;
const BW = 460;            // block width, identical for trunk and both branches
const GAP = W - 2 * BW;    // space between the two branches
const LABEL = 220;         // label column inside a block
const cell = 11;
const step = 14;
const rowH = 19;
const BUILD = 9;

const mins = (ms: typeof modules) => ms.reduce((s, m) => s + m.lessons.reduce((a, l) => a + l.minutes, 0), 0);
const hrs = (n: number) => `${Math.round(n / 60)} h`;
const code = (slug: string, l: string) => flatLessons.find((f) => f.module.slug === slug && f.slug === l)!.code;
const short = (t: string, n: number) => (t.length > n ? t.slice(0, n - 1) + '…' : t);

type Row = { m: (typeof modules)[number]; x: number; y: number };
type Head = { x: number; y: number; text: string; sub: string };

const trunk = modules.filter((m) => m.part === 1);
const build = modules.filter((m) => m.part === BUILD);
const fast = modules.filter((m) => m.part !== 1 && m.part !== BUILD);

const rows: Row[] = [];
const heads: Head[] = [];
const groups: { x: number; y: number; text: string }[] = [];

const xT = (W - BW) / 2;
const xB = 0;
const xF = BW + GAP;

// Trunk, centred.
let y = 20;
heads.push({ x: xT, y, text: 'Everyone: the trunk', sub: `${trunk.length} modules · ${hrs(mins(trunk))}` });
y += 26;
for (const m of trunk) { rows.push({ m, x: xT, y }); y += rowH; }
const trunkEnd = y;

// A symmetric fork from the trunk's centre to the centre of each branch.
const forkMid = trunkEnd + 20;
const branchTop = forkMid + 22;
const cT = xT + BW / 2;
const cB = xB + BW / 2;
const cF = xF + BW / 2;

y = branchTop + 14;
heads.push({ x: xB, y, text: 'Branch: Build with it', sub: `${build.length} modules · ${hrs(mins(build))}` });
heads.push({ x: xF, y, text: 'Branch: Make it fast', sub: `${fast.length} modules · ${hrs(mins(fast))}` });
y += 26;

function column(ms: typeof modules, x: number, y0: number) {
  let yy = y0;
  let last = 0;
  for (const m of ms) {
    if (m.part !== last) {
      const p = parts.find((q) => q.num === m.part)!;
      if (last !== 0) yy += 8;
      groups.push({ x, y: yy + 9, text: `Part ${p.label ?? p.num} · ${p.title}` });
      yy += 18;
      last = m.part;
    }
    rows.push({ m, x, y: yy });
    yy += rowH;
  }
  return yy;
}
const yb = column(build, xB, y);
const yf = column(fast, xF, y);
const H = Math.max(yb, yf) + 6;
const hours = Math.round(totalMinutes / 60);
---
<figure class="coursemap">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`The course as a map: a shared trunk of ${trunk.length} modules, then two branches, Build with it and Make it fast. ${flatLessons.length} lessons, about ${hours} hours.`}>
    <path d={`M ${cT} ${trunkEnd + 2} V ${forkMid} M ${cB} ${branchTop} V ${forkMid} H ${cF} V ${branchTop}`} class="fork" />
    {heads.map((h) => (
      <g>
        <text x={h.x} y={h.y} class="head">{h.text}</text>
        <text x={h.x + BW} y={h.y} text-anchor="end" class="hsub">{h.sub}</text>
        <line x1={h.x} x2={h.x + BW} y1={h.y + 8} y2={h.y + 8} class="rule" />
      </g>
    ))}
    {groups.map((g) => <text x={g.x} y={g.y} class="phead">{g.text}</text>)}
    {rows.map((r) => (
      <a href={url(`learn/${r.m.slug}/`)} class="row">
        <title>{r.m.num} {r.m.title}</title>
        <rect x={r.x - 4} y={r.y - 3} width={BW + 8} height={rowH - 1} rx="3" class="hit" />
        <text x={r.x} y={r.y + 10} class="rlabel"><tspan class="rnum">{r.m.num}</tspan> {short(r.m.title, 30)}</text>
        {r.m.lessons.map((l, i) => (
          <rect x={r.x + LABEL + i * step} y={r.y + 1} width={cell} height={cell} rx="2" class:list={['sp', l.kind]} data-lesson-key={`${r.m.slug}/${l.slug}`}><title>{code(r.m.slug, l.slug)} {l.title} · {l.minutes} min</title></rect>
        ))}
        <text x={r.x + BW} y={r.y + 10} text-anchor="end" class="mh">{hrs(r.m.lessons.reduce((a, l) => a + l.minutes, 0))}</text>
      </a>
    ))}
  </svg>
  <figcaption>
    <span><i class="key k-lesson" /> lesson</span>
    <span><i class="key k-lab" /> lab or project</span>
    <span><i class="key k-done" /> done</span>
    <span>{flatLessons.length} lessons · about {hours} hours in all · take the trunk, then either branch or both</span>
  </figcaption>
</figure>

<style>
  .coursemap { margin: 0; overflow-x: auto; }
  svg { width: 100%; min-width: 760px; height: auto; display: block; overflow: visible; }
  .head { font: 600 12.5px var(--font-sans); fill: var(--text); }
  .hsub { font: 11px var(--font-mono); fill: var(--text-3); }
  .rule { stroke: var(--rule-2); }
  .phead { font: 10px var(--font-mono); fill: var(--text-3); letter-spacing: 0.04em; }
  .fork { fill: none; stroke: var(--rule-2); stroke-width: 1.2; }
  .rlabel { font: 11.5px var(--font-sans); fill: var(--text-2); }
  .rnum { font-family: var(--font-mono); fill: var(--text-3); }
  .mh { font: 10.5px var(--font-mono); fill: var(--text-3); }
  .hit { fill: transparent; }
  .row:hover .hit { fill: var(--ground-3); }
  .row:hover .rlabel { fill: var(--text); }
  .sp { fill: transparent; stroke: var(--rule-2); stroke-width: 1; transition: fill 0.4s, stroke 0.4s; }
  .sp.lab, .sp.project { fill: url(#tps-hatch); }
  .sp:global(.is-done) { fill: var(--text-2); stroke: var(--text-2); }
  .sp:global(.is-flag) { fill: var(--compute); stroke: var(--compute); }
  figcaption { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.4rem; font-size: 0.75rem; color: var(--text-3); margin-top: 1rem; }
  figcaption span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .key { width: 10px; height: 10px; border-radius: 2px; border: 1px solid var(--rule-2); display: inline-block; }
  .key.k-lab { background: repeating-linear-gradient(135deg, var(--idle) 0 1.5px, transparent 1.5px 4px); }
  .key.k-done { background: var(--text-2); border-color: var(--text-2); }
</style>
