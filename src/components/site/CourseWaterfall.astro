---
// The entire course as one waterfall trace: each module is a track, each lesson a span placed at
// its cumulative study time. Completed lessons fill in as the learner progresses.
import { modules, flatLessons, parts, totalMinutes } from '../../data/course';
import { url } from '../../site';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;

const W = 1000;
const labelW = compact ? 0 : 210;
const rowH = compact ? 9 : 12;
const gap = compact ? 3 : 4;
const partGap = compact ? 8 : 14;
const top = 26;
const scale = (W - labelW - 10) / totalMinutes;

let t = 0;
let y = top;
let lastPart = 0;
const rows = modules.map((m) => {
  if (m.part !== lastPart) { if (lastPart !== 0) y += partGap; lastPart = m.part; }
  const start = t;
  const spans = m.lessons.map((l) => {
    const fl = flatLessons.find((f) => f.module.slug === m.slug && f.slug === l.slug)!;
    const s = { x: labelW + t * scale, w: Math.max(1.5, l.minutes * scale - 1), key: `${m.slug}/${l.slug}`, kind: l.kind, title: `${fl.code} ${l.title}` };
    t += l.minutes;
    return s;
  });
  const row = { m, y, start, end: t, spans };
  y += rowH + gap;
  return row;
});
const H = y + 8;
const hours = Math.ceil(totalMinutes / 60);
const tickEvery = 5;
const ticks = Array.from({ length: Math.floor(hours / tickEvery) + 1 }, (_, i) => i * tickEvery);
---
<figure class:list={['waterfall', { compact }]}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`The whole course as a timeline: ${modules.length} modules, about ${hours} hours of study.`}>
    <line x1={labelW} x2={W - 10} y1={14} y2={14} class="axis" />
    {ticks.map((h) => (
      <g>
        <line x1={labelW + h * 60 * scale} x2={labelW + h * 60 * scale} y1={14} y2={H - 4} class="grid" />
        <text x={labelW + h * 60 * scale} y={9} text-anchor="middle" class="tick">{h}h</text>
      </g>
    ))}
    {rows.map((r) => (
      <a href={url(`learn/${r.m.slug}/`)} class="row">
        <title>{r.m.num} {r.m.title}</title>
        {!compact && <text x={labelW - 12} y={r.y + rowH / 2 + 4} text-anchor="end" class="rlabel"><tspan class="rnum">{r.m.num}</tspan> {r.m.title.length > 26 ? r.m.title.slice(0, 25) + '…' : r.m.title}</text>}
        <rect x={labelW + r.start * scale - 3} y={r.y - 2} width={(r.end - r.start) * scale + 6} height={rowH + 4} class="hit" />
        {r.spans.map((s) => (
          <rect x={s.x} y={r.y} width={s.w} height={rowH} rx="1.5" class:list={['sp', s.kind]} data-lesson-key={s.key}><title>{s.title}</title></rect>
        ))}
      </a>
    ))}
  </svg>
  {!compact && (
    <figcaption>
      <span><i class="key k-lesson" /> lesson</span>
      <span><i class="key k-lab" /> lab or project</span>
      <span><i class="key k-done" /> done</span>
      <span>{flatLessons.length} lessons · about {hours} hours · {parts.length} parts</span>
    </figcaption>
  )}
</figure>

<style>
  .waterfall { margin: 0; overflow-x: auto; }
  svg { width: 100%; min-width: 680px; height: auto; display: block; overflow: visible; }
  .axis { stroke: var(--rule-2); }
  .grid { stroke: var(--rule); stroke-dasharray: 2 4; }
  .tick { font: 10px var(--font-mono); fill: var(--text-3); }
  .rlabel { font: 11px var(--font-sans); fill: var(--text-2); }
  .rnum { font-family: var(--font-mono); fill: var(--text-3); }
  .hit { fill: transparent; }
  .row:hover .hit { fill: var(--ground-3); }
  .row:hover .rlabel { fill: var(--text); }
  .sp { fill: transparent; stroke: var(--rule-2); stroke-width: 1; transition: fill 0.4s, stroke 0.4s; }
  .sp.lab, .sp.project { fill: url(#tps-hatch); }
  .sp:global(.is-done) { fill: var(--text-2); stroke: var(--text-2); }
  .sp:global(.is-flag) { fill: var(--compute); stroke: var(--compute); }
  .compact .sp { stroke: var(--rule-2); }
  figcaption { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; font-size: 0.75rem; color: var(--text-3); margin-top: 0.8rem; padding-left: 21%; }
  figcaption span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .key { width: 16px; height: 8px; border-radius: 1.5px; border: 1px solid var(--rule-2); display: inline-block; }
  .key.k-lab { background: repeating-linear-gradient(135deg, var(--idle) 0 1.5px, transparent 1.5px 4px); }
  .key.k-done { background: var(--text-2); border-color: var(--text-2); }
  @media (max-width: 700px) { figcaption { padding-left: 0; } .rlabel { font-size: 13px; } }
</style>
