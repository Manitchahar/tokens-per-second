---
interface Props { caption?: string; wide?: boolean }
const { caption, wide } = Astro.props;
---
<figure class:list={['fig', { wide }]}>
  <slot />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  .fig { margin: 2.2rem 0; }
  figure.fig.wide { grid-column: wide; }
  figcaption { font-size: 0.82rem; color: var(--text-2); margin-top: 0.6rem; }
</style>
