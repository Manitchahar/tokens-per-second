---
interface Props { title?: string }
const { title } = Astro.props;
---
<div class="step" data-step>
  {title && <h4>{title}</h4>}
  <slot />
</div>

<style>
  .step {
    margin: 0 0 42vh;
    padding: 0.2rem 0 0.2rem 1.1rem;
    border-left: 1px solid var(--rule);
    opacity: 0.38;
    transition: opacity 0.5s var(--ease-out), border-color 0.5s;
    font-size: 0.97rem;
  }
  .step:last-child { margin-bottom: 0; }
  .step:global(.is-active) { opacity: 1; border-left-color: var(--text); }
  .step:global(.is-past) { opacity: 0.55; }
  .step h4 { font-size: 0.98rem; margin: 0 0 0.5rem; }
  .step :global(p:last-child) { margin-bottom: 0; }
  @media (max-width: 900px) { .step { margin-bottom: 55vh; background: var(--ground); } }
  @media print { .step { opacity: 1; margin-bottom: 1rem; } }
</style>
