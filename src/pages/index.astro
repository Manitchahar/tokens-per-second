---
import Base from '../layouts/Base.astro';
import HeroTrace from '../components/viz/trace/HeroTrace.tsx';
import CourseWaterfall from '../components/site/CourseWaterfall.astro';
import Icon from '../components/Icon.astro';
import { flatLessons, modules, parts, totalMinutes } from '../data/course';
import { url } from '../site';
const first = flatLessons[0];
const labs = flatLessons.filter((l) => l.kind !== 'lesson').length;
---
<Base description="A free, visual, first-principles course that takes you from zero to inference engineer: GPUs, transformers, KV cache, batching, quantization, kernels, multi-GPU and production.">
  <section class="hero">
    <div class="hero-text">
      <h1>Tokens per Second</h1>
      <p class="promise">Learn how a GPU turns a prompt into words, and how to make it faster and cheaper. Every idea is taught from first principles, and every step moves on screen.</p>
      <div class="cta">
        <a class="btn" href={url(first.href)} data-hero-start>Start the course <Icon name="arrow" size={16} /></a>
        <a class="btn ghost" href={url('learn/')}>See the course map</a>
      </div>
      <p class="fine">Free. No account. You need a little Python; everything else is taught here.</p>
    </div>
    <div class="hero-viz">
      <HeroTrace client:load />
    </div>
  </section>

  <section class="band read">
    <div class="band-inner">
      <h2>That trace is the whole job</h2>
      <p>
        Above, one chat message makes the round trip. The <span class="ink k-compute">amber</span> block is the GPU reading your whole prompt at once.
        The <span class="ink k-memory">blue</span> blocks are the GPU producing the answer one token at a time, each step bottlenecked on reading billions of numbers from memory.
        Each <span class="ink k-token">green</span> mark is a word you see.
      </p>
      <p>
        An inference engineer's job is to make that picture shorter, fit more people into it at once, and pay less for it, without breaking the answer.
        This course teaches you how, from the arithmetic of a single matrix multiply to a fleet of GPUs serving millions.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="band-inner wide">
      <header class="sec-head">
        <h2>The course, drawn as a trace</h2>
        <p>{modules.length} modules in {parts.length} parts, {flatLessons.length} lessons, about {Math.round(totalMinutes / 60)} hours. Each row is a module. Rows fill in as you finish lessons.</p>
      </header>
      <CourseWaterfall />
    </div>
  </section>

  <section class="band">
    <div class="band-inner wide how">
      <h2>How every lesson teaches</h2>
      <ol class="how-list">
        <li><strong>Why it matters.</strong> Every lesson opens with the problem, in plain words, before any jargon.</li>
        <li><strong>Watch it move.</strong> A pinned animation steps forward as you scroll. Pause it, rewind it, drag the sliders.</li>
        <li><strong>Derive it.</strong> The math, from first principles, with numbers you can check on a calculator.</li>
        <li><strong>Run it.</strong> Real code, then a lab on a real GPU in free Google Colab, or a simulator right in the page.</li>
        <li><strong>Keep it.</strong> A quiz to check yourself, key notes, a cheat sheet per module, and your own notes saved beside every lesson.</li>
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="band-inner wide kit">
      <a href={url('labs/')}><Icon name="flask" size={22} /><strong>{labs} labs & projects</strong><span>Colab notebooks and in-browser simulators. No GPU of your own needed.</span></a>
      <a href={url('cheatsheets/')}><Icon name="sheet" size={22} /><strong>Cheat sheets</strong><span>Every formula and rule of thumb on one printable page per module.</span></a>
      <a href={url('tools/')}><Icon name="tool" size={22} /><strong>Calculators</strong><span>Will this model fit? How big is the KV cache? What does a million tokens cost?</span></a>
      <a href={url('glossary/')}><Icon name="book" size={22} /><strong>Glossary</strong><span>Every term in plain words, linked to the lesson that teaches it.</span></a>
    </div>
  </section>

  <section class="band closing">
    <div class="band-inner">
      <h2>Start with one message</h2>
      <p>The first lesson slows down a single chat request and shows you every place it spends time. Fifteen minutes, no setup.</p>
      <a class="btn" href={url(first.href)} data-hero-start>{first.code} {first.title} <Icon name="arrow" size={16} /></a>
    </div>
  </section>
</Base>

<script>
  import { load } from '../scripts/progress';
  const s = load();
  if (s.last) document.querySelectorAll<HTMLAnchorElement>('[data-hero-start]').forEach((a, i) => {
    a.href = s.last!.href;
    if (i === 0) a.firstChild!.textContent = 'Resume ';
  });
</script>

<style>
  .hero {
    max-width: 1320px; margin: 0 auto; padding: clamp(2.5rem, 6vw, 5rem) 24px 3rem;
    display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr); gap: 3rem; align-items: center;
  }
  h1 { font-size: clamp(3rem, 7.4vw, 6rem); line-height: 0.98; letter-spacing: -0.02em; margin-bottom: 1.4rem; }
  .promise { font-size: clamp(1.05rem, 1.6vw, 1.22rem); color: var(--text-2); max-width: 34ch; line-height: 1.55; }
  .cta { display: flex; gap: 0.8rem; flex-wrap: wrap; margin: 2rem 0 1rem; }
  .fine { font-size: 0.8rem; color: var(--text-3); }
  .hero-viz { min-width: 0; }
  .band { border-top: 1px solid var(--rule); }
  .band-inner { max-width: 760px; margin: 0 auto; padding: 4.5rem 24px; }
  .band-inner.wide { max-width: 1240px; }
  .band h2 { font-size: clamp(1.9rem, 3.6vw, 2.7rem); margin-bottom: 1.2rem; }
  .read p { font-size: 1.08rem; color: var(--text-2); }
  .sec-head { max-width: 720px; margin-bottom: 2.2rem; }
  .sec-head p { color: var(--text-2); }
  .how { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: 3rem; }
  .how-list { list-style: none; margin: 0; padding: 0; counter-reset: how; }
  .how-list li { counter-increment: how; position: relative; padding: 1rem 0 1rem 2.6rem; border-bottom: 1px solid var(--rule); color: var(--text-2); }
  .how-list li::before { content: counter(how); position: absolute; left: 0; top: 0.95rem; font-family: var(--font-display); font-size: 1.5rem; color: var(--text-3); line-height: 1.1; }
  .how-list strong { color: var(--text); margin-right: 0.3rem; }
  .kit { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
  .kit a { display: grid; gap: 0.4rem; align-content: start; padding: 1.6rem 1.6rem 1.8rem 0; margin-right: 1.6rem; border-top: 1px solid var(--rule-2); text-decoration: none; }
  .kit a :global(.icon) { color: var(--text-2); margin-bottom: 0.4rem; transition: color 0.2s, transform 0.3s var(--ease-out); }
  .kit a:hover :global(.icon) { color: var(--compute); transform: translateY(-2px); }
  .kit strong { font-size: 1.02rem; }
  .kit span { font-size: 0.88rem; color: var(--text-2); }
  .closing .band-inner { text-align: left; }
  .closing p { color: var(--text-2); font-size: 1.05rem; margin-bottom: 1.6rem; }
  @media (max-width: 1000px) {
    .hero { grid-template-columns: 1fr; gap: 2rem; }
    .how { grid-template-columns: 1fr; gap: 1rem; }
    .kit { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .hero, .band-inner { padding-left: 16px; padding-right: 16px; }
    .kit { grid-template-columns: 1fr; }
    .kit a { margin-right: 0; }
  }
</style>
