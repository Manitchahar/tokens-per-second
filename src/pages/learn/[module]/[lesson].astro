---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import LessonTrack from '../../../components/site/LessonTrack.astro';
import NotesDrawer from '../../../components/learn/NotesDrawer.tsx';
import { mdxComponents } from '../../../components/mdx';
import Icon from '../../../components/Icon.astro';
import { findLesson, flatLessons, parts } from '../../../data/course';
import { url } from '../../../site';

export async function getStaticPaths() {
  const entries = await getCollection('lessons');
  return entries.map((entry) => {
    const [module, lesson] = entry.id.split('/');
    return { params: { module, lesson }, props: { entry } };
  });
}

const { entry } = Astro.props;
const [moduleSlug, lessonSlug] = entry.id.split('/');
const meta = findLesson(moduleSlug, lessonSlug);
if (!meta) throw new Error(`Lesson ${entry.id} is not in src/data/course.ts`);
const { Content } = await render(entry);

const all = await getCollection('lessons');
const available = new Set(all.map((e) => e.id));
const key = entry.id;
const mod = meta.module;
const part = parts.find((p) => p.num === mod.part)!;
const modLessons = flatLessons.filter((l) => l.module.slug === mod.slug);
const prev = [...flatLessons].slice(0, meta.index).reverse().find((l) => available.has(`${l.module.slug}/${l.slug}`));
const next = flatLessons.slice(meta.index + 1).find((l) => available.has(`${l.module.slug}/${l.slug}`));
const kindLabel = meta.kind === 'lesson' ? 'Lesson' : meta.kind === 'lab' ? 'Lab' : 'Project';
const d = entry.data;
---
<Base title={d.title} description={d.summary}>
  <article class="lesson" data-lesson={key} data-href={url(meta.href)} data-code={meta.code} data-title={d.title}>
    <header class="lesson-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={url('learn/')}>Part {part.label ?? part.num} · {part.title}</a>
        <span aria-hidden="true">/</span>
        <a href={url(`learn/${mod.slug}/`)}>{mod.num} {mod.title}</a>
      </nav>
      <LessonTrack lessons={modLessons} current={key} available={available} />
      <p class="meta">
        <span class="code">{meta.code}</span>
        <span>{kindLabel}</span>
        <span>{meta.minutes} min</span>
      </p>
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
      {d.objectives.length > 0 && (
        <div class="objectives">
          <p class="obj-title">By the end, you can:</p>
          <ul>{d.objectives.map((o) => <li>{o}</li>)}</ul>
        </div>
      )}
    </header>

    <div class="prose">
      <Content components={mdxComponents} />
    </div>

    <footer class="lesson-foot">
      <button type="button" class="btn done-btn" data-done-toggle>
        <Icon name="check" size={16} /> <span data-done-label>Mark lesson complete</span>
      </button>
      <nav class="pn" aria-label="Lesson navigation">
        {prev ? (
          <a class="pn-link prev" href={url(prev.href)}>
            <span class="pn-dir"><Icon name="prev" size={14} /> Previous</span>
            <span class="pn-title"><span class="code">{prev.code}</span> {prev.title}</span>
          </a>
        ) : <span />}
        {next && (
          <a class="pn-link next" href={url(next.href)}>
            <span class="pn-dir">Next <Icon name="next" size={14} /></span>
            <span class="pn-title"><span class="code">{next.code}</span> {next.title}</span>
          </a>
        )}
      </nav>
    </footer>
  </article>
  <NotesDrawer client:idle lessonKey={key} title={`${meta.code} ${d.title}`} />
</Base>

<script>
  import { load, setDone, setLast } from '../../../scripts/progress';
  const art = document.querySelector<HTMLElement>('[data-lesson]');
  if (art) {
    const key = art.dataset.lesson!;
    setLast({ key, href: art.dataset.href!, code: art.dataset.code!, title: art.dataset.title! });
    const btn = document.querySelector<HTMLButtonElement>('[data-done-toggle]')!;
    const label = btn.querySelector('[data-done-label]')!;
    const paint = () => {
      const done = !!load().done[key];
      btn.classList.toggle('is-done', done);
      label.textContent = done ? 'Completed. Click to undo' : 'Mark lesson complete';
    };
    btn.addEventListener('click', () => { setDone(key, !load().done[key]); paint(); });
    paint();
  }
</script>

<style>
  .lesson {
    --gutter: 16px;
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gutter), 1fr)
      [wide-start] minmax(0, 250px)
      [content-start] min(var(--measure), 100% - 2 * var(--gutter)) [content-end]
      minmax(0, 250px) [wide-end]
      minmax(var(--gutter), 1fr) [full-end];
    padding-top: 2.2rem;
  }
  .lesson > * { grid-column: content; }
  .lesson-head { margin-bottom: 2.2rem; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.8rem; color: var(--text-3); margin-bottom: 1rem; }
  .crumbs a { color: var(--text-2); text-decoration: none; }
  .crumbs a:hover { color: var(--text); }
  .meta { display: flex; gap: 1.1rem; font-size: 0.8rem; color: var(--text-2); margin: 1.6rem 0 0.5rem; }
  .code { font-family: var(--font-mono); color: var(--text-3); }
  h1 { font-size: clamp(2.1rem, 5vw, 3.3rem); line-height: 1.08; margin: 0 0 1rem; }
  .lead { font-size: 1.15rem; color: var(--text-2); line-height: 1.55; margin-bottom: 1.6rem; }
  .objectives { border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 1rem 0 0.6rem; }
  .obj-title { font-size: 0.82rem; font-weight: 700; margin-bottom: 0.4rem; }
  .objectives ul { margin: 0; padding: 0 0 0 1.1rem; font-size: 0.93rem; color: var(--text-2); }
  .objectives li { margin-bottom: 0.3rem; }
  .objectives li::marker { color: var(--text-3); }

  .prose { display: contents; }
  .prose :global(> *) { grid-column: content; }
  /* islands (Quiz, standalone visuals) render with display: contents, so place their content too */
  .prose :global(> astro-island > *) { grid-column: content; min-width: 0; }
  .prose :global(> h2) { font-size: clamp(1.6rem, 3.4vw, 2.1rem); margin: 3.6rem 0 1rem; }
  .prose :global(> h3) { font-size: 1.1rem; margin: 2.4rem 0 0.7rem; }
  .prose :global(> ul), .prose :global(> ol) { padding-left: 1.25rem; margin: 0 0 1.2em; }
  .prose :global(li) { margin-bottom: 0.35em; }
  .prose :global(li::marker) { color: var(--text-3); }
  .prose :global(> blockquote) { margin: 1.6rem 0; padding-left: 1rem; border-left: 1px solid var(--rule-2); color: var(--text-2); font-style: italic; }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 0.88rem; margin: 1.6rem 0; font-variant-numeric: tabular-nums; }
  .prose :global(th) { text-align: left; font-weight: 700; color: var(--text); border-bottom: 1px solid var(--rule-2); padding: 0.5rem 0.6rem 0.5rem 0; }
  .prose :global(td) { border-bottom: 1px solid var(--rule); padding: 0.5rem 0.6rem 0.5rem 0; color: var(--text-2); vertical-align: top; }
  .prose :global(> .table-wrap) { overflow-x: auto; }
  .prose :global(strong) { color: var(--text); }

  .lesson-foot { margin-top: 3rem; padding-top: 1.6rem; border-top: 1px solid var(--rule-2); }
  .done-btn { width: 100%; justify-content: center; padding: 1rem; font-size: 0.95rem; }
  .done-btn:global(.is-done) { background: transparent; color: var(--text); border-color: var(--text-2); }
  .pn { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.4rem; }
  .pn-link { display: grid; gap: 0.3rem; padding: 0.9rem 1rem; border: 1px solid var(--rule); border-radius: 4px; text-decoration: none; transition: border-color 0.2s; }
  .pn-link:hover { border-color: var(--text-2); }
  .pn-link.next { text-align: right; grid-column: 2; }
  .pn-dir { font-size: 0.75rem; color: var(--text-3); display: inline-flex; align-items: center; gap: 0.3rem; }
  .next .pn-dir { justify-content: flex-end; }
  .pn-title { font-size: 0.92rem; }
  @media (max-width: 640px) { .pn { grid-template-columns: 1fr; } .pn-link.next { grid-column: 1; } }
</style>
