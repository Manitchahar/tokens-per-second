---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import LessonTrack from '../../../components/site/LessonTrack.astro';
import Icon from '../../../components/Icon.astro';
import { modules, flatLessons, parts } from '../../../data/course';
import { url } from '../../../site';

export function getStaticPaths() {
  return modules.map((m) => ({ params: { module: m.slug } }));
}
const { module: slug } = Astro.params;
const mod = modules.find((m) => m.slug === slug)!;
const part = parts.find((p) => p.num === mod.part)!;
const all = await getCollection('lessons');
const available = new Set(all.map((e) => e.id));
const byId = new Map(all.map((e) => [e.id, e]));
const lessons = flatLessons.filter((l) => l.module.slug === mod.slug);
const sheets = await getCollection('cheatsheets');
const sheet = sheets.find((s) => s.data.module === mod.slug);
const idx = modules.indexOf(mod);
const prevMod = modules[idx - 1];
const nextMod = modules[idx + 1];
const keys = lessons.map((l) => `${mod.slug}/${l.slug}`).join(',');
const mins = mod.lessons.reduce((s, l) => s + l.minutes, 0);
---
<Base title={`${mod.num} ${mod.title}`} description={mod.tagline}>
  <div class="page">
    <nav class="crumbs"><a href={url('learn/')}>Course map</a> <span>/</span> <a href={url(`learn/#part-${part.num}`)}>Part {part.num} · {part.title}</a></nav>
    <header class="head">
      <p class="mnum">Module {mod.num}</p>
      <h1>{mod.title}</h1>
      <p class="lead">{mod.tagline}</p>
      <p class="meta"><span data-module-progress={keys}>0/{lessons.length}</span> done · {lessons.length} lessons · about {Math.round(mins / 6) / 10} hours</p>
    </header>

    <LessonTrack lessons={lessons} available={available} size="md" />

    <ol class="list">
      {lessons.map((l) => {
        const key = `${mod.slug}/${l.slug}`;
        const e = byId.get(key);
        const has = !!e;
        return (
          <li class:list={['row', l.kind, { missing: !has }]} data-lesson-key={key}>
            <span class="code">{l.code}</span>
            <div class="body">
              {has ? <a href={url(l.href)} class="title">{l.title}</a> : <span class="title">{l.title}</span>}
              {e && <p class="sum">{e.data.summary}</p>}
              {!has && <p class="sum">Being written.</p>}
            </div>
            <span class="kind">{l.kind === 'lesson' ? '' : l.kind === 'lab' ? 'Lab' : 'Project'} {l.minutes} min</span>
            <span class="mark" aria-hidden="true"><Icon name="check" size={16} /></span>
          </li>
        );
      })}
    </ol>

    <div class="extras">
      {sheet && <a class="btn ghost" href={url(`cheatsheets/${mod.slug}/`)}><Icon name="sheet" size={16} /> Module cheat sheet</a>}
      <a class="btn ghost" href={url('labs/')}><Icon name="flask" size={16} /> All labs</a>
    </div>

    <nav class="mods">
      {prevMod ? <a href={url(`learn/${prevMod.slug}/`)}><span>Previous module</span>{prevMod.num} {prevMod.title}</a> : <span />}
      {nextMod && <a class="nx" href={url(`learn/${nextMod.slug}/`)}><span>Next module</span>{nextMod.num} {nextMod.title}</a>}
    </nav>
  </div>
</Base>

<style>
  .page { max-width: 900px; margin: 0 auto; padding: 2.2rem 24px 0; }
  .crumbs { font-size: 0.8rem; color: var(--text-3); display: flex; gap: 0.5rem; }
  .crumbs a { color: var(--text-2); text-decoration: none; }
  .head { margin: 1.6rem 0 2rem; }
  .mnum { font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-3); margin: 0 0 0.4rem; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); margin-bottom: 0.8rem; }
  .lead { font-size: 1.12rem; color: var(--text-2); margin-bottom: 0.6rem; }
  .meta { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-3); }
  .list { list-style: none; padding: 0; margin: 2rem 0 0; border-top: 1px solid var(--rule-2); }
  .row { display: grid; grid-template-columns: 3.4rem 1fr auto 1.5rem; gap: 1rem; align-items: baseline; padding: 1.1rem 0; border-bottom: 1px solid var(--rule); }
  .code { font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-3); }
  .title { font-size: 1.05rem; font-weight: 700; text-decoration: none; }
  a.title:hover { text-decoration: underline; }
  .missing .title { color: var(--text-3); font-weight: 400; }
  .sum { margin: 0.25rem 0 0; font-size: 0.88rem; color: var(--text-2); }
  .kind { font-size: 0.75rem; color: var(--text-3); white-space: nowrap; font-family: var(--font-mono); }
  .mark { color: transparent; }
  .row:global(.is-done) .mark { color: var(--token); }
  .row:global(.is-done) .code { color: var(--token); }
  .extras { display: flex; gap: 0.8rem; flex-wrap: wrap; margin: 2rem 0; }
  .mods { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 3rem; }
  .mods a { display: grid; gap: 0.2rem; padding: 0.9rem 1rem; border: 1px solid var(--rule); border-radius: 4px; text-decoration: none; }
  .mods a:hover { border-color: var(--text-2); }
  .mods a span { font-size: 0.74rem; color: var(--text-3); }
  .mods .nx { text-align: right; grid-column: 2; }
  @media (max-width: 640px) { .row { grid-template-columns: 2.8rem 1fr 1.2rem; } .kind { display: none; } .page { padding: 1.6rem 16px 0; } }
</style>
