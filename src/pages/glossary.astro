---
import Base from '../layouts/Base.astro';
import { glossary } from '../data/glossary';
import { flatLessons } from '../data/course';
import { url } from '../site';

const entries = Object.entries(glossary).sort((a, b) => a[1].term.localeCompare(b[1].term, 'en', { sensitivity: 'base' }));
const lessonFor = (key?: string) => (key ? flatLessons.find((l) => `${l.module.slug}/${l.slug}` === key) : undefined);
---
<Base title="Glossary" description="Every inference engineering term, in plain words, linked to the lesson that teaches it.">
  <div class="page">
    <h1>Glossary</h1>
    <p class="lead">Every term this course uses, in plain words. Each links to the lesson that teaches it properly.</p>
    <label class="search">
      <span class="visually-hidden">Filter terms</span>
      <input type="search" placeholder="Filter terms, e.g. KV, decode, FP8" data-filter autocomplete="off" />
    </label>
    <dl class="gl">
      {entries.map(([key, e]) => {
        const l = lessonFor(e.lesson);
        return (
          <div class="row" id={key} data-text={(e.term + ' ' + e.def).toLowerCase()}>
            <dt>{e.term}</dt>
            <dd>
              {e.def}
              {l && <a class="where" href={url(l.href)}>{l.code} {l.title}</a>}
            </dd>
          </div>
        );
      })}
    </dl>
    <p class="empty" hidden data-empty>No terms match. Try a shorter word.</p>
  </div>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-filter]')!;
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.row'));
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let n = 0;
    rows.forEach((r) => { const show = !q || r.dataset.text!.includes(q); r.hidden = !show; if (show) n++; });
    empty.hidden = n > 0;
  });
</script>

<style>
  .page { max-width: 860px; margin: 0 auto; padding: 3rem 24px 0; }
  h1 { font-size: clamp(2.3rem, 5vw, 3.4rem); margin-bottom: 0.8rem; }
  .lead { color: var(--text-2); margin-bottom: 2rem; }
  .search input { width: 100%; font: inherit; padding: 0.75rem 0.9rem; background: var(--ground-2); color: var(--text); border: 1px solid var(--rule-2); border-radius: 4px; }
  .search input::placeholder { color: var(--text-3); }
  .gl { margin: 2rem 0 0; }
  .row { display: grid; grid-template-columns: minmax(160px, 240px) 1fr; gap: 0.4rem 2rem; padding: 1rem 0; border-bottom: 1px solid var(--rule); scroll-margin-top: 80px; }
  .row:target { background: var(--ground-2); }
  dt { font-weight: 700; }
  dd { margin: 0; color: var(--text-2); font-size: 0.94rem; }
  .where { display: block; margin-top: 0.35rem; font-size: 0.8rem; color: var(--text-3); }
  .where:hover { color: var(--text); }
  .empty { color: var(--text-3); margin-top: 2rem; }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; } .page { padding: 2rem 16px 0; } }
</style>
